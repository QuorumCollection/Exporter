{
	"name": "quorum/exporter",
	"description": "Export Data as Spreadsheets",
	"require": {
		"php": ">=8.1",
		"ext-SPL": "*",
		"ext-dom": "*",
		"ext-json": "*",
		"ext-mbstring": "*",
		"maennchen/zipstream-php": "^3.0"
	},
	"require-dev": {
		"ext-zip": "*",
		"donatj/drop": "*",
		"phpunit/phpunit": "^10.5",
		"friendsofphp/php-cs-fixer": "=3.95.30",
		"squizlabs/php_codesniffer": "^3.6",
		"corpus/coding-standard": "^0.9.0",
		"donatj/mddoc": "^0.14.1",
		"phpstan/phpstan": "^2.3",
		"corpus/php-cs-fixer-config": "=0.1.1"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Jesse Donat",
			"email": "donatj@gmail.com"
		}
	],
	"autoload": {
		"psr-4": {
			"Quorum\\Exporter\\": "src/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
